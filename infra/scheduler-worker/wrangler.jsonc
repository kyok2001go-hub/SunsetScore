{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunsetscore-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "13 4 * * *",
      "13 8 * * *"
    ]
  }
}
